{
  "name": "imivr-bobfintech",
  "version": "1.0.7",
  "description": "我是面试官 - 基于本地优先架构的面试辅助系统",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "imivr": "dist/cli/index.js"
  },
  "files": [
    "dist/cli",
    "dist/web"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:cli && pnpm build:web",
    "build:cli": "tsup src/cli/index.ts --format esm --out-dir dist/cli --clean",
    "build:web": "tsc && vite build --outDir dist/web",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@clack/prompts": "^1.3.0",
    "adm-zip": "^0.5.17",
    "antd": "^5.15.0",
    "browser-fs-access": "^0.38.0",
    "commander": "^14.0.3",
    "dayjs": "^1.11.10",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "markitdown-ts": "^0.0.10",
    "open": "^11.0.0",
    "playwright": "^1.59.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-html": "^16.0.1",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vite": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "interview",
    "面试",
    "ai",
    "assistant",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DuLianYong-Chinese/imivr"
  }
}
